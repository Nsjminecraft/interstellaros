#!/bin/bash
# InterstellarOS install script - run from live ISO to install to disk
set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log() { echo -e "${GREEN}[INFO]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }

if [[ $EUID -ne 0 ]]; then
    error "This script must be run as root"
fi

echo "=========================================="
echo "  InterstellarOS Installation"
echo "=========================================="
echo

# List available disks
log "Available disks:"
lsblk -d -o NAME,SIZE,MODEL,TYPE | grep disk
echo

read -p "Enter target disk (e.g., sda, nvme0n1): " DISK
if [[ ! -b /dev/$DISK ]]; then
    error "Disk /dev/$DISK does not exist"
fi

echo
warn "This will erase all data on /dev/$DISK"
read -p "Are you sure? (yes/no): " CONFIRM
if [[ "$CONFIRM" != "yes" ]]; then
    error "Installation cancelled"
fi

# Detect UEFI or BIOS
if [[ -d /sys/firmware/efi ]]; then
    BOOT_MODE="uefi"
    log "Detected UEFI boot mode"
else
    BOOT_MODE="bios"
    log "Detected BIOS boot mode"
fi

# Partition disk
log "Partitioning /dev/$DISK..."
if [[ "$BOOT_MODE" == "uefi" ]]; then
    # UEFI: EFI partition (512MB) + root (rest)
    parted -s /dev/$DISK mklabel gpt
    parted -s /dev/$DISK mkpart ESP fat32 1MiB 513MiB
    parted -s /dev/$DISK set 1 esp on
    parted -s /dev/$DISK mkpart primary btrfs 513MiB 100%
    BOOT_PART="/dev/${DISK}1"
    ROOT_PART="/dev/${DISK}2"
else
    # BIOS: boot partition (1MB) + root (rest)
    parted -s /dev/$DISK mklabel msdos
    parted -s /dev/$DISK mkpart primary ext4 1MiB 2MiB
    parted -s /dev/$DISK set 1 bios_grub on
    parted -s /dev/$DISK mkpart primary btrfs 2MiB 100%
    ROOT_PART="/dev/${DISK}2"
fi

# Format partitions
log "Formatting partitions..."
if [[ "$BOOT_MODE" == "uefi" ]]; then
    mkfs.fat -F32 "$BOOT_PART"
fi
mkfs.btrfs -f "$ROOT_PART"

# Mount partitions
log "Mounting partitions..."
mount "$ROOT_PART" /mnt
if [[ "$BOOT_MODE" == "uefi" ]]; then
    mkdir -p /mnt/boot
    mount "$BOOT_PART" /mnt/boot
fi

# Install base system
log "Installing base system (this may take several minutes)..."
pacstrap /mnt base base-devel linux-cachyos linux-firmware intel-ucode amd-ucode \
    networkmanager openssh nftables sudo vim git bash-completion

# Generate fstab
log "Generating fstab..."
genfstab -U /mnt >> /mnt/etc/fstab

# Configure system in chroot
log "Configuring system..."
arch-chroot /mnt /bin/bash <<EOF
# Set hostname
read -p "Enter hostname: " HOSTNAME
echo "\$HOSTNAME" > /etc/hostname

# Set timezone
ln -sf /usr/share/zoneinfo/UTC /etc/localtime
hwclock --systohc

# Set locale
echo "en_US.UTF-8 UTF-8" > /etc/locale.gen
locale-gen
echo "LANG=en_US.UTF-8" > /etc/locale.conf

# Set root password
echo "Setting root password..."
passwd

# Create admin user
read -p "Enter admin username: " ADMIN_USER
useradd -m -G wheel -s /bin/bash "\$ADMIN_USER"
echo "Setting password for \$ADMIN_USER..."
passwd "\$ADMIN_USER"

# Enable sudo for wheel group
echo "%wheel ALL=(ALL) ALL" > /etc/sudoers.d/wheel

# Install bootloader
if [[ "$BOOT_MODE" == "uefi" ]]; then
    bootctl install
    cat > /boot/loader/loader.conf <<LOADER
default interstellaros.conf
timeout 3
LOADER
    cat > /boot/loader/entries/interstellaros.conf <<ENTRY
title   InterstellarOS
linux   /vmlinuz-linux-cachyos
initrd  /intel-ucode.img
initrd  /amd-ucode.img
initrd  /initramfs-linux-cachyos.img
options root=$ROOT_PART rw
ENTRY
else
    pacman -S --noconfirm grub
    grub-install --target=i386-pc /dev/$DISK
    grub-mkconfig -o /boot/grub/grub.cfg
fi

# Enable services
systemctl enable NetworkManager sshd nftables

echo
echo "Installation complete!"
echo "Reboot and remove the installation media."
EOF

umount -R /mnt

log "Installation finished!"
log "You can now reboot: reboot"
